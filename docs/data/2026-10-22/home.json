 "headlines": [
  {
   "text": "한은 오늘 금통위, 동결 유력하지만 11월 추가 인상 여지를 남기는 '매파적 동결' 전망. 원/달러 1323.94원 연저점 경신",
   "importance": 5,
   "topic": "macro",
   "topic_name": "거시경제"
  },
  {
   "text": "스페이스X 첫 흑자로 AI 투심이 회복되며 나스닥 +1.05%, 필라델피아 반도체 +1.97%, VIX 16.68로 하락",
   "importance": 5,
   "topic": "us",
   "topic_name": "미국시장"
  },
  {
   "text": "미국 반도체 +1.97%에도 코스피는 전날 3% 반등 후 차익실현으로 1%대 하락 출발…5700선 공방, 하락 종목이 상승의 2배 이상",
   "importance": 5,
   "topic": "kr",
   "topic_name": "한국시장"
  },
  {
   "text": "스페이스X 첫 흑자·슈퍼마이크로·메타 호실적에 미국 AI주 반등(나스닥 +1.05%, SOX +1.97%)… 코스피는 차익실현에 5700선 하회",
   "importance": 5,
   "topic": "sectors",
   "topic_name": "섹터별 주요뉴스"
  },
  {
   "text": "프랑스 국채금리 2002년 이후 최고, 5% 돌파… 재정 불안과 시위 속에 ECB 개입 시점을 두고 전망 엇갈려",
   "importance": 5,
   "topic": "eu",
   "topic_name": "유럽시장"
  }
 ],
