 "headlines": [
  {
   "text": "연준 금리 인상 재개·카시카리 '인플레 전방위' 발언에 미 10년물 5.00% 도달, 월가는 추가 인상 대비",
   "importance": 5,
   "topic": "macro",
   "topic_name": "거시경제"
  },
  {
   "text": "미 10년물 5% 재돌파에도 반도체지수 +2.78% 급등…S&P500 +0.17%·나스닥 +0.39%, 다우·러셀은 하락한 혼조 마감",
   "importance": 5,
   "topic": "us",
   "topic_name": "미국시장"
  },
  {
   "text": "코스피 9/18 +2.66%(6,894.23) 마감 후 21일 장중 8거래일 만에 7,000선 일시 회복 — 외국인·기관 동반 매수, 삼성전자 +3%대",
   "importance": 5,
   "topic": "kr",
   "topic_name": "한국시장"
  },
  {
   "text": "연준 인상·10년물 5%에도 반도체 질주(필라델피아 반도체 +2.78%, SOXX +2.69%) — 코스피 삼성전자 +3.73% 앞세워 장중 8거래일 만에 7000선 회복, 다만 상승 273 대 하락 507로 종목 장세는 좁음",
   "importance": 5,
   "topic": "sectors",
   "topic_name": "섹터별 주요뉴스"
  },
  {
   "text": "유럽 증시 3주 연속 하락 마감 — 호르무즈 유조선 피격·아람코 유럽 공급 감축에 자동차(폭스바겐 -5.6%)·통신주 급락, DAX -1.60%",
   "importance": 5,
   "topic": "eu",
   "topic_name": "유럽시장"
  }
