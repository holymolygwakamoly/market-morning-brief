 "headlines": [
  {
   "text": "트럼프, 이란의 호르무즈 재개방안 거부 → 브렌트 105.28달러(+0.92%), 미 10년물 5.24%로 상승",
   "importance": 5,
   "topic": "macro",
   "topic_name": "거시경제"
  },
  {
   "text": "트럼프의 이란 호르무즈 계획 거부로 유가·금리 동반 상승, AI 안전성 우려까지 겹쳐 S&P500 -0.77%, 나스닥 -0.92%, SOX -1.61% 하락",
   "importance": 5,
   "topic": "us",
   "topic_name": "미국시장"
  },
  {
   "text": "미 국채금리 급등과 반도체 대형주 5%대 약세에 코스피 2.70% 하락, 6889.74로 6900선 붕괴(9월 28일)",
   "importance": 5,
   "topic": "kr",
   "topic_name": "한국시장"
  },
  {
   "text": "엔비디아 칩 허용설·정상회담 실망에 中 기술주 급락 — 심천 -3.44%, 창업판 -4.53%, 상해 -1.67%로 사흘째 하락",
   "importance": 5,
   "topic": "cn",
   "topic_name": "중국시장"
  },
  {
   "text": "유럽증시, 트럼프의 이란 호르무즈 개방안 거부·유가 반등에 보합권 혼조 마감(DAX -0.13%, FTSE100 -0.10%, CAC40 +0.01%)",
   "importance": 4,
   "topic": "eu",
   "topic_name": "유럽시장"
  }
 ],
