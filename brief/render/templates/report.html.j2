{% extends "base.html.j2" %}
{% macro quote_rows(quotes, with_prev=False) -%}
{% for q in quotes %}<tr>
<td>{{ q.name }}<span class="badge">{{ q.asof|kst("%m-%d %H:%M") }} KST</span></td>
{% if with_prev %}<td class="num">{% if q.prev_close is not none %}{{ "{:,.2f}".format(q.prev_close) }}{% else %}-{% endif %}</td>{% endif %}
<td class="num">{{ "{:,.2f}".format(q.close) }}</td>
<td class="num {{ 'up' if q.change_pct > 0 else ('down' if q.change_pct < 0 else 'flat') }}">{{ q.change_pct|pct }}</td>
</tr>
{% endfor %}{% for e in quote_errors %}<tr><td colspan="{{ 4 if with_prev else 3 }}" class="fail">데이터 없음 — {{ e }}</td></tr>
{% endfor %}
{%- endmacro %}
{% macro sector_cards(items) -%}
{% for s in items %}<article class="sector-card">
<h3>{{ s.name }}<span class="badge market">{{ s.market }}</span></h3>
<div class="sector-text">{{ s.reason|paragraphs }}</div>
{% if s.us_view %}<div class="label">미국 관점</div><div class="sector-text">{{ s.us_view|paragraphs }}</div>{% endif %}
{% if s.kr_impact %}<div class="label">한국장 영향</div><div class="sector-text">{{ s.kr_impact|paragraphs }}</div>{% endif %}
<ul class="leaders">
{% for l in s.leaders %}<li><strong>{{ l.name }}</strong>{% if l.ticker %}<span class="ticker">{{ l.ticker }}</span>{% endif %} — {{ l.comment }}</li>
{% endfor %}</ul>
</article>
{% endfor %}
{%- endmacro %}
{% block main %}
<section id="summary">
<h1>{{ date }} 시장 아침 브리핑</h1>
<p class="meta">생성 {{ (status.finished_at_kst or status.started_at_kst)[:16]|replace("T", " ") }} KST · {{ status.result }} · <a href="archive.html">아카이브</a></p>
<h2>핵심 5</h2>
<ol class="headline5">
{% for h in report.headline5 %}<li>{{ h }}</li>
{% endfor %}</ol>
<h2>시장 시그널</h2>
<div class="table-wrap"><table class="signals">
<thead><tr><th>지표</th><th>종가</th><th>등락</th></tr></thead>
<tbody>
{{ quote_rows(quotes) }}</tbody>
</table></div>
{% if report.signal_comments %}<ul class="signal-comments">
{% for c in report.signal_comments %}<li>{{ c }}</li>
{% endfor %}</ul>{% endif %}
</section>
<section id="analysis">
<h2>상세 분석</h2>
{% for key, label in [("issue", "이슈"), ("up", "상승"), ("down", "하락")] %}{% if sector_groups[key] %}
<h2 class="direction direction-{{ key }}">{{ label }}</h2>
{{ sector_cards(sector_groups[key]) }}{% endif %}{% endfor %}
<section id="ai-sector" class="ai">
<h2>AI 섹터</h2>
<div class="sector-text">{{ report.ai_sector|paragraphs }}</div>
</section>
{% if report.events_today %}<h2>오늘의 일정</h2>
<ul class="events">
{% for e in report.events_today %}<li>{{ e }}</li>
{% endfor %}</ul>{% endif %}
{% if report.macro_notes %}<h2>거시 메모</h2>
<div class="macro-notes">{{ report.macro_notes|paragraphs }}</div>{% endif %}
</section>
<section id="references">
<h2>지표</h2>
<div class="table-wrap"><table class="indicators">
<thead><tr><th>지표</th><th>전일</th><th>종가</th><th>등락</th></tr></thead>
<tbody>
{{ quote_rows(quotes, True) }}</tbody>
</table></div>
<h2>소스 상태</h2>
<div class="table-wrap"><table class="sources">
<thead><tr><th>소스</th><th>상태</th><th>건수</th><th>오류</th></tr></thead>
<tbody>
{% for s in status.sources %}<tr>
<td>{{ s.name }}{% if s.required %} <span class="badge">필수</span>{% endif %}</td>
<td class="{{ 'ok' if s.ok else 'fail' }}">{{ '✓' if s.ok else '✗' }}</td>
<td class="num">{{ s.count }}</td>
<td>{{ s.error or '' }}</td>
</tr>
{% endfor %}</tbody>
</table></div>
<h2>기사 링크</h2>
{% if groups %}<ul class="articles">
{% for key, arts in groups.items() %}<li>
<ul>
{% for a in arts %}<li><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a> <span class="meta">{{ a.publisher or a.source }}</span><span class="badge">{{ a.lang }}</span><span class="meta"> {{ a.published_at|kst("%m-%d %H:%M") }}</span></li>
{% endfor %}</ul>
</li>
{% endfor %}</ul>{% else %}<p class="meta">기사 없음</p>{% endif %}
{% if thebell %}<h2>더벨 헤드라인 (Google News)</h2>
<ul class="thebell">
{% for a in thebell %}<li><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a><span class="meta"> {{ a.published_at|kst("%m-%d %H:%M") }}</span></li>
{% endfor %}</ul>{% endif %}
<p class="disclaimer">{{ report.disclaimer }}</p>
</section>
{% endblock %}
{% block scripts %}
<script>
(function(){
  try{
    var now=new Date();
    var today=new Intl.DateTimeFormat("en-CA",{timeZone:"Asia/Seoul"}).format(now);
    var parts=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Seoul",hour:"numeric",minute:"numeric",hour12:false}).formatToParts(now);
    var h=0,m=0;
    parts.forEach(function(p){if(p.type==="hour")h=parseInt(p.value,10)%24;if(p.type==="minute")m=parseInt(p.value,10);});
    var wd=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Seoul",weekday:"short"}).format(now);
    var generated=document.documentElement.dataset.generated;
    var header=document.querySelector("#status-banner");
    var failedOn=header?header.dataset.failedOn:undefined;
    if(wd!=="Sat"&&wd!=="Sun"&&(h>8||(h===8&&m>=30))&&generated!==today&&failedOn!==today){
      var el=document.getElementById("stale-banner");
      if(el){el.textContent="이 페이지는 "+generated+" 보고서입니다. 오늘("+today+") 자동 생성이 실행되지 않았을 수 있습니다.";el.hidden=false;}
    }
  }catch(e){}
})();
</script>
{% endblock %}
