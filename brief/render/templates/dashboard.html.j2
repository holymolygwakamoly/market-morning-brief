<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>시장 아침 브리핑 — 대시보드</title>
<style>
:root{--fg:#1f2328;--muted:#656d76;--bg:#fff;--line:#d0d7de;--card:#f6f8fa;--ok:#1a7f37;--fail:#cf222e;--link:#0969da}
*{box-sizing:border-box}
body{margin:0;padding:0 16px 48px;font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Noto Sans KR",Roboto,sans-serif;color:var(--fg);background:var(--bg);word-break:keep-all;overflow-wrap:anywhere}
main{max-width:900px;margin:0 auto}
h1{font-size:1.6rem;line-height:1.3;margin:20px 0 12px}
h2{font-size:1.25rem;margin:28px 0 12px;padding-bottom:6px;border-bottom:2px solid var(--line)}
p{margin:0 0 10px}
a{color:var(--link);text-decoration:none}
a:hover{text-decoration:underline}
.meta{color:var(--muted);font-size:.85rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:0 0 12px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
input[type=date]{font:inherit;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:#fff}
button{font:inherit;padding:7px 14px;border:1px solid var(--line);border-radius:6px;background:#fff;cursor:pointer}
button.primary{background:var(--link);border-color:var(--link);color:#fff}
button:disabled{opacity:.5;cursor:not-allowed}
.badge{display:inline-block;font-size:.8rem;line-height:1;padding:4px 8px;border-radius:10px;background:#fff;border:1px solid var(--line);color:var(--muted);vertical-align:middle;white-space:nowrap}
.badge.running{border-color:#d4a72c;background:#fff8c5;color:#4d2d00}
.badge.done{border-color:#4ac26b;background:#dafbe1;color:var(--ok)}
.badge.failed{border-color:#ff8182;background:#ffebe9;color:#82071e}
pre{background:#fff;border:1px solid var(--line);border-radius:6px;padding:10px;font-size:.82rem;line-height:1.45;max-height:320px;overflow:auto;white-space:pre-wrap;margin:8px 0 0}
.ok{color:var(--ok)}
.fail{color:var(--fail)}
.warn{color:#4d2d00;background:#fff8c5;border:1px solid #d4a72c;border-radius:6px;padding:6px 10px;font-size:.9rem;margin:8px 0}
.error{color:#82071e;background:#ffebe9;border:1px solid #ff8182;border-radius:6px;padding:6px 10px;font-size:.9rem;margin:8px 0}
ul.recent{list-style:none;padding:0;margin:0}
ul.recent li{margin:4px 0}
.empty-msg{color:var(--muted)}
@media (max-width:480px){body{font-size:15px}h1{font-size:1.35rem}}
</style>
</head>
<body>
<main>
<h1>시장 아침 브리핑 — 대시보드</h1>
<p class="meta">오늘(KST): <span id="today">{{ today }}</span> · <a href="/docs/index.html">최신 보고서(index)</a> · <a href="/docs/archive.html">아카이브</a></p>

<h2>생성</h2>
<div class="card">
<div class="row">
<input type="date" id="date" min="{{ min_date }}" max="{{ max_date }}" value="{{ today }}">
<button id="generate" class="primary">보고서 생성</button>
</div>
<p class="meta" style="margin-top:8px">오늘(KST) 기준 3일 전까지만 선택 가능. 과거 날짜는 RSS에 남아 있는 기사만 수집되어 내용이 적을 수 있습니다.</p>
<div id="generate-msg" class="error" hidden></div>
</div>

<h2>진행 상태</h2>
<div class="card">
<div class="row">
<span>단계: <span id="stage" class="badge">-</span></span>
<span>경과: <span id="elapsed">0:00</span></span>
<span id="job-date" class="meta"></span>
</div>
<div id="result" style="margin-top:8px"></div>
<pre id="log">(대기 중)</pre>
</div>

<h2>최근 보고서</h2>
<div class="card">
<ul id="recent" class="recent">
{% for r in recent %}<li><a href="{{ r.url }}">{{ r.date }}</a>{% if r.result %} <span class="badge{% if r.result == 'failed' %} failed{% endif %}">{{ r.result }}</span>{% endif %}</li>
{% else %}<li class="empty-msg">아직 생성된 보고서가 없습니다.</li>{% endfor %}
</ul>
</div>

<h2>게시</h2>
<div class="card">
<div class="row">
<button id="publish"{% if not can_publish %} disabled{% endif %}>GitHub에 게시</button>
{% if not can_publish %}<span class="meta">git 원격(origin)이 없어 게시할 수 없습니다.</span>{% endif %}
</div>
<p class="meta" style="margin-top:8px">GitHub Pages(main //docs) 설정이 되어 있으면 공개 URL에서 볼 수 있습니다.</p>
<pre id="publish-out" hidden></pre>
</div>
</main>
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var poll = null, tick = null, base = 0, baseAt = 0, running = false;

  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function fmt(sec) { sec = Math.max(0, Math.floor(sec)); var m = Math.floor(sec / 60), s = sec % 60; return m + ':' + (s < 10 ? '0' : '') + s; }
  function showElapsed() { $('elapsed').textContent = fmt(running ? base + (Date.now() - baseAt) / 1000 : base); }

  function render(s) {
    running = !!s.running;
    base = s.elapsed_s || 0; baseAt = Date.now();
    var stage = $('stage');
    stage.textContent = s.stage || '-';
    stage.className = 'badge' + (running ? ' running' : (s.stage === 'done' ? ' done' : (s.stage === 'failed' ? ' failed' : '')));
    $('job-date').textContent = s.date ? '대상 날짜: ' + s.date : '';
    $('log').textContent = (s.log && s.log.length) ? s.log.join('\n') : (running ? '(시작 중...)' : '(대기 중)');
    var log = $('log'); log.scrollTop = log.scrollHeight;
    var html = '';
    if (!running && s.result) {
      if (s.result === 'failed') {
        html += '<div class="error">생성 실패: ' + esc(s.error || '원인 불명') + '</div>';
      } else {
        html += '<p><span class="ok">완료 (' + esc(s.result) + ')</span>';
        if (s.report_url) html += ' · <a href="' + esc(s.report_url) + '" target="_blank">보고서 열기</a>';
        html += ' · <a href="/docs/index.html" target="_blank">최신 보고서(index)</a></p>';
        if (s.warnings && s.warnings.length) html += '<div class="warn">경고: ' + esc(s.warnings.join(', ')) + '</div>';
      }
    } else if (running) {
      html = '<p class="meta">생성 중입니다. 보통 3~6분 걸립니다.</p>';
    }
    $('result').innerHTML = html;
    if (s.recent) renderRecent(s.recent);
    $('generate').disabled = running;
    showElapsed();
    if (running && !tick) tick = setInterval(showElapsed, 1000);
    if (!running && tick) { clearInterval(tick); tick = null; }
    if (running && !poll) poll = setInterval(refresh, 2000);
    if (!running && poll) { clearInterval(poll); poll = null; }
  }

  function renderRecent(list) {
    var ul = $('recent');
    if (!list.length) { ul.innerHTML = '<li class="empty-msg">아직 생성된 보고서가 없습니다.</li>'; return; }
    ul.innerHTML = list.map(function (r) {
      return '<li><a href="' + esc(r.url) + '">' + esc(r.date) + '</a>' +
        (r.result ? ' <span class="badge' + (r.result === 'failed' ? ' failed' : '') + '">' + esc(r.result) + '</span>' : '') + '</li>';
    }).join('');
  }

  function refresh() {
    return fetch('/api/status', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(render).catch(function () {});
  }

  function showMsg(text) { var m = $('generate-msg'); m.textContent = text; m.hidden = !text; }

  $('generate').addEventListener('click', function () {
    showMsg('');
    var date = $('date').value;
    var min = $('date').min, max = $('date').max;
    if (!date) { showMsg('날짜를 선택하세요.'); return; }
    if (date < min || date > max) { showMsg('날짜는 ' + min + ' ~ ' + max + ' 사이여야 합니다.'); return; }
    $('generate').disabled = true;
    fetch('/api/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ date: date }) })
      .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
      .then(function (res) {
        if (res.status === 202) { $('log').textContent = '(시작 중...)'; return refresh(); }
        if (res.status === 409) showMsg('이미 생성 중입니다. 완료 후 다시 시도하세요.');
        else showMsg(res.body.error || ('요청 실패 (' + res.status + ')'));
        $('generate').disabled = false;
      })
      .catch(function (e) { showMsg('요청 실패: ' + e); $('generate').disabled = false; });
  });

  $('publish').addEventListener('click', function () {
    var btn = $('publish'), out = $('publish-out');
    btn.disabled = true; out.hidden = false; out.textContent = '게시 중...';
    fetch('/api/publish', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (j) { out.textContent = (j.ok ? '[성공] ' : '[실패] ') + (j.output || ''); })
      .catch(function (e) { out.textContent = '[실패] ' + e; })
      .then(function () { btn.disabled = false; });
  });

  refresh();
})();
</script>
</body>
</html>
