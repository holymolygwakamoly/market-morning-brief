{% extends "base.html.j2" %}
{% block title %}보고서 아카이브{% endblock %}
{% block main %}
<section id="archive">
<h1>보고서 아카이브</h1>
<p class="meta"><a href="index.html">최신 보고서</a> · 총 {{ entries|length }}건</p>
{% if entries %}<ul class="archive-list">
{% for e in entries %}<li><a href="reports/{{ e.date }}.html">{{ e.date }}</a>{% if e.result %} <span class="badge{% if e.result == 'failed' %} fail{% endif %}">{{ e.result }}</span>{% endif %}</li>
{% endfor %}</ul>{% else %}<p class="empty-msg">아직 생성된 보고서가 없습니다.</p>{% endif %}
</section>
{% endblock %}
