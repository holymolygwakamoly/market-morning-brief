<!doctype html>
<html lang="ko" data-generated="{{ date }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ date }} 시장 아침 브리핑{% endblock %}</title>
<style>
:root{--fg:#1f2328;--muted:#656d76;--bg:#fff;--line:#d0d7de;--card:#f6f8fa;--up:#c62828;--down:#1565c0;--ai:#eef4ff;--ai-line:#8fb3ff}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;padding:0 16px 48px;font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Noto Sans KR",Roboto,sans-serif;color:var(--fg);background:var(--bg);word-break:keep-all;overflow-wrap:anywhere}
header#status-banner,main,footer{max-width:900px;margin:0 auto}
header#status-banner{padding-top:12px}
h1{font-size:1.6rem;line-height:1.3;margin:16px 0 12px}
h2{font-size:1.25rem;margin:32px 0 12px;padding-bottom:6px;border-bottom:2px solid var(--line)}
h3{font-size:1.05rem;margin:0 0 8px}
p{margin:0 0 10px}
ul,ol{padding-left:22px;margin:0 0 12px}
li{margin:4px 0}
a{color:#0969da;text-decoration:none}
a:hover{text-decoration:underline}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 0 12px}
table{border-collapse:collapse;width:100%;min-width:420px;font-size:.95rem}
th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;white-space:nowrap}
th{background:var(--card);font-weight:600}
td.num{text-align:right;font-variant-numeric:tabular-nums}
.up{color:var(--up)}
.down{color:var(--down)}
.flat{color:var(--muted)}
.badge{display:inline-block;font-size:.72rem;line-height:1;padding:3px 6px;border-radius:10px;background:var(--card);border:1px solid var(--line);color:var(--muted);vertical-align:middle;margin-left:4px;white-space:nowrap}
.banner{padding:12px 14px;border-radius:8px;margin:0 0 10px;font-size:.95rem;border:1px solid}
.banner-error{background:#ffebe9;border-color:#ff8182;color:#82071e}
.banner-warn{background:#fff8c5;border-color:#d4a72c;color:#4d2d00}
.stale{background:#f3f4f6;border-color:#c9a227;color:#57534e}
.sector-card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:0 0 12px}
.sector-card .market{margin-left:6px}
.sector-text{margin:0 0 8px}
.sector-card .label{font-weight:600;color:var(--muted);font-size:.85rem;margin:8px 0 2px}
ul.leaders{list-style:none;padding:0;margin:8px 0 0;font-size:.92rem;border-top:1px dashed var(--line);padding-top:8px}
ul.leaders li{margin:2px 0}
ul.leaders .ticker{color:var(--muted);font-size:.8rem;margin-left:4px}
section.ai{background:var(--ai);border:1px solid var(--ai-line);border-radius:10px;padding:14px 16px;margin:16px 0}
section.ai h2{border:0;margin:0 0 8px;padding:0}
.meta{color:var(--muted);font-size:.85rem}
.ok{color:#1a7f37}
.fail{color:#cf222e}
ul.articles li{margin:6px 0}
ul.articles ul{margin:2px 0 0;padding-left:16px;list-style:disc}
.disclaimer{color:var(--muted);font-size:.85rem;border-top:1px solid var(--line);padding-top:12px;margin-top:24px}
.empty-msg{color:var(--muted);padding:24px 0}
@media (max-width:480px){body{font-size:15px}h1{font-size:1.35rem}h2{font-size:1.15rem}th,td{padding:5px 6px}}
</style>
</head>
<body>
{% include "_header.html.j2" %}
<main>
{% block main %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
